    "scores": {
      "nSOFA": {
        "compute": true
      },
      "VIS": {
        "compute": true
      },
      "sf_ratio": {
        "compute": true
      }
    },
    
    "features": {
      "spikes_drops": {
        "on_basis": "min",
        "upstream": true,
        "variables": ["HR", "SBP", "DBP", "RR", "SpO2", "FiO2", "PEEP", "MAP", "sf_ratio"]
      },
      "trends": {
        "on_basis": "hour",
        "upstream": false,
        "variables": ["HR", "SBP", "DBP", "RR", "SpO2", "FiO2", "bodyT", "PEEP", "MAP", "sf_ratio"]
      },
      "std_feat": {
        "on_basis": "min",
        "upstream": true,
        "variables": ["HR", "SBP", "DBP", "RR", "SpO2", "FiO2", "PEEP", "MAP", "sf_ratio"]
      },
      "kurt_skew": {
        "on_basis": "min",
        "upstream": true,
        "kurtosis": true,
        "skewness": true,
        "variables": ["HR", "SBP", "DBP", "RR", "SpO2", "FiO2", "PEEP", "MAP", "sf_ratio"]
      },
      "entropy": {
        "on_basis": "min",
        "upstream": true,
        "variables": ["HR", "SBP", "DBP", "RR", "SpO2", "FiO2", "PEEP", "MAP", "sf_ratio"]
      },
      "time_sepsis": {
        "on_basis": "hour",
        "upstream": false
      }
    },

    "time_window_selection": {
      "resampling_strategy": "continuous",
      "resampling_frequency": 6,
      "resampling_factor": 20
    },

    "patient_selection": {
      "random": {
        "extract": true
      },
      "knn": {
        "extract": false,
        "nb_time_windows_control": 3,
        "shift_time_windows_controls": 6,
        "columns": {
          "numerical": [
            "ga_weeks",
            "birth_weight"
          ],
          "categorical": [
            "sex"
          ]
        }
      }
    },

    "patients_to_select": {
      "sepsis": {
        "include": ["sepsis_halos"],
        "exclude": []
      },
      "controls": {
        "include": [],
        "exclude": ["nec", "sepsis", "death_hospital"]
      }
