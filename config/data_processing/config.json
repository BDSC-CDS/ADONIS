{
  "environment": "BioMedIT",  

  "experiment": {
    "type": "data_extraction",

    "extract_data": false,
    "extract_demographics": false,
    "extract_hero": false,
    "extract_nsofa": false,

    "hospitals": {
      "CHUV": {
        "original_name": "CHUV",
        "name": "Lausanne University Hospital",
        "wards": ["NAT - Hospit. néonat.", "NAT - Héb. SI néonat. A", "NAT - Héb. mixte néonat. D+E"],
        "include": true
      },
      "KISPI": {
        "original_name": "Universitäts-Kinderspital Zürich - Eleonorenstiftung",
        "name": "Zurich Children Hospital",
        "wards": ["Surgery", "Paediatrics", "Cardiology"],
        "include": true
      },
      "USZ": {
        "original_name": "University Hospital Zürich",
        "name": "Zurich University Hospital",
        "wards": ["Other"],
        "include": true
      }
    },

    "tags": {
      "project": "ADONIS"
    },

    "params": {
      "batch_size": 1000,
      "upstream_period": 72,

      "prediction_time": 1,
      "transition": 0,

      "forewarning_time": 12,
      "nb_time_windows_sepsis": 3,
      "shift_time_windows_sepsis": 6,
      "include_all_sepsis": true,
      "max_train_size": false,

      "days_to_exclude": 2,
      "max_gestational_age": 43,
      "min_length_stay_hours": 48,
      "supercontrols": false,
      "self_controls": true,
      "self_controls_time": 72,
      "nb_to_select": 1,
      "three_days": true,
      "hours_to_exclude_abx": 72,
      "sepsis_rate": [0.05, 0.10, 0.30, 0.50]
    },

    "logging": {
      "checkpoint_freq": 1
    },

    "variables": {
      "vitals": {
        "HR": {
          "extract": true,
          "name_param": "HR",
          "units": ["cblbeatcbrpermin", "permin"],
          "min": 0,
          "max": 300, 
          "lab": false,
          "impute": true,
          "concept": "HeartRate",
          "ffill_min": 90,
          "ffill_max": 180, 
          "ffill_limit": 120
        },
        "SpO2": {
          "extract": true,
          "name_param": "SpO2",
          "units": ["percent"],
          "min": 0,
          "max": 100,
          "lab": false,
          "impute": true,
          "concept": "OxygenSaturation",
          "ffill_min": 88,
          "ffill_max": 100, 
          "ffill_limit": 120
        },
        "RR": {
          "extract": true,
          "name_param": "RR",
          "units": ["cblbreathcbrpermin", "permin"],
          "min": 0, 
          "max": 140,
          "lab": false,
          "impute": true,
          "concept": "RespiratoryRate",
          "priority": ["SNOMED-CT-258104002","SNOMED-CT-258090004","SNOMED-CT-87982008"],
          "ffill_min": 30,
          "ffill_max": 65, 
          "ffill_limit": 120
        },
        "SBP": {
          "extract": true,
          "name_param": "SBP",
          "units": ["mmsblHgsbr"],
          "min": 10,
          "max": 160, 
          "lab": false,
          "impute": true,
          "concept": "BloodPressure",
          "ffill_min": 30,
          "ffill_max": 90, 
          "ffill_limit": 120
        },
        "DBP": {
          "extract": true,
          "name_param": "DBP",
          "units": ["mmsblHgsbr"],
          "min": 0,
          "max": 100,
          "lab": false,
          "impute": true,
          "concept": "BloodPressure",
          "ffill_min": 10,
          "ffill_max": 70, 
          "ffill_limit": 120
        },
        "FiO2": {
          "extract": true,
          "name_param": "FiO2",
          "units": ["percent"],
          "min": 20,
          "max": 100,
          "lab": false,
          "impute": true,
          "concept": "FractionOfInspiredOxygen",
          "default_value": 21,
          "ffill_min": 21,
          "ffill_max": 21, 
          "ffill_limit": 120
        }
      },
      "observations": {
        "bodyT": {
          "extract": true,
          "name_param": "bodyT",
          "units": ["Cel"],
          "min": 33,
          "max": 41, 
          "lab": false,
          "impute": true,
          "concept": "BodyTemperature",
          "perc_deviation": 0.3,
          "ffill_min": 36.5,
          "ffill_max": 37.5, 
          "ffill_limit": 120
